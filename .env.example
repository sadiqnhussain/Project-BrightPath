# Copy to .env for Docker Compose deployment and replace every example value.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-generated-by-a-password-manager
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=your-domain.example,www.your-domain.example
SECURE_SSL_REDIRECT=1

POSTGRES_DB=kidslearning
POSTGRES_USER=kidslearning
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DEFAULT_FROM_EMAIL=no-reply@your-domain.example
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1

# Local development: do not load this production .env; run Django with its defaults,
# which use SQLite and DEBUG=1. You may export DJANGO_DEBUG=1 locally if needed.
